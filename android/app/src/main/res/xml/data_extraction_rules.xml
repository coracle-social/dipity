<?xml version="1.0" encoding="utf-8"?>
<!--
  A restored copy of the identity is unreadable, because it is wrapped by a
  Keystore key that never leaves the device. The store lives in noBackupFilesDir, which neither
  path copies. docs/storage.md#the-sqlite-store
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="social.coracle.dipity.identity.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="social.coracle.dipity.identity.xml" />
    </device-transfer>
</data-extraction-rules>
