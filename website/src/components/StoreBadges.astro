---
// The official store badges. The store links are filled in once the listings are live.
const APP_STORE_URL = "#"
const PLAY_URL = "#"

interface Props {
  class?: string
}

const {class: className = ""} = Astro.props
---

<div class:list={["flex flex-wrap items-center gap-3", className]}>
  <a href={APP_STORE_URL} aria-label="Download on the App Store">
    <img src="/badges/app-store.png" alt="Download on the App Store" class="h-13 w-auto" width="180" height="60" />
  </a>
  <a href={PLAY_URL} aria-label="Get it on Google Play">
    <img src="/badges/google-play.png" alt="Get it on Google Play" class="h-13 w-auto" width="180" height="60" />
  </a>
</div>
