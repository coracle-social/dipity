---
// The board as the app draws it, recreated in markup so it stays crisp and follows the theme.
import {
  Bookmark,
  CalendarDays,
  Clock,
  ListChecks,
  MapPin,
  MessageCircle,
  Plus,
  Settings,
  Signpost,
  Smile,
  Users,
} from "@lucide/astro"

interface Props {
  class?: string
}

const {class: className = ""} = Astro.props
---

<div
  class:list={[
    "relative w-[19rem] rounded-[3rem] bg-foreground/90 p-2.5 shadow-2xl sm:w-[21rem]",
    className,
  ]}>
  <div class="relative h-[38rem] overflow-hidden rounded-[2.5rem] bg-background">
    <div class="absolute top-2.5 left-1/2 h-6 w-24 -translate-x-1/2 rounded-full bg-foreground/90">
    </div>

    <div class="px-4 pt-12">
      <p class="text-xl font-semibold">Community Board</p>
      <div class="mt-3 flex gap-1 rounded-full bg-muted p-1 text-xs font-medium">
        <span class="rounded-full bg-card px-3 py-1 shadow-sm">New to you</span>
        <span class="px-3 py-1 text-muted-foreground">Recent</span>
      </div>
    </div>

    <div class="mt-3 space-y-3 px-3">
      <article class="rounded-lg bg-card p-3.5 shadow-sm">
        <header class="flex items-center justify-between text-sm">
          <span class="font-semibold">Malcolm</span>
          <MessageCircle class="size-4 text-muted-foreground" />
        </header>
        <p class="mt-1.5 text-sm text-pretty">
          Whoever is leaving plums on the wall by the bakery: thank you. Best I've had in years.
        </p>
        <footer class="mt-2.5 flex items-center justify-between text-[0.7rem] text-muted-foreground">
          <span>9:41 AM · from Ana</span>
          <span class="flex gap-2.5"><Smile class="size-3.5" /><Bookmark class="size-3.5" /></span>
        </footer>
      </article>

      <article class="rounded-lg bg-card p-3.5 shadow-sm">
        <header class="flex items-center justify-between text-sm">
          <span class="font-semibold">Ana</span>
          <CalendarDays class="size-4 text-muted-foreground" />
        </header>
        <div class="mt-1.5 rounded-md border border-secondary-accent/40 px-2.5 py-2">
          <p class="text-sm font-semibold">Street sweep &amp; potluck</p>
          <p class="mt-0.5 flex items-center gap-1 text-xs text-secondary-accent">
            <Clock class="size-3" /> Saturday 10:00 AM
          </p>
          <p class="flex items-center gap-1 text-xs text-muted-foreground">
            <MapPin class="size-3" /> The corner of Ellis &amp; 8th
          </p>
        </div>
        <footer class="mt-2.5 text-[0.7rem] text-muted-foreground">Yesterday · two hops</footer>
      </article>

      <article class="rounded-lg bg-card p-3.5 shadow-sm">
        <header class="flex items-center justify-between text-sm">
          <span class="font-semibold">Irving</span>
          <ListChecks class="size-4 text-muted-foreground" />
        </header>
        <p class="mt-1.5 text-sm font-semibold">Movie night on the green?</p>
        <div class="mt-2 space-y-1 text-xs">
          <div class="relative overflow-hidden rounded-md bg-muted px-2.5 py-1.5">
            <div class="absolute inset-y-0 left-0 w-2/3 bg-primary/20"></div>
            <span class="relative">Saturday</span>
          </div>
          <div class="relative overflow-hidden rounded-md bg-muted px-2.5 py-1.5">
            <div class="absolute inset-y-0 left-0 w-1/3 bg-primary/20"></div>
            <span class="relative">Monday</span>
          </div>
        </div>
      </article>
    </div>

    <div
      class="absolute right-4 bottom-20 flex size-12 items-center justify-center rounded-full bg-primary text-primary-foreground shadow-control">
      <Plus class="size-5" />
    </div>

    <nav
      class="absolute inset-x-0 bottom-0 grid grid-cols-4 border-t bg-card pt-2 pb-4 text-[0.65rem] font-medium text-muted-foreground">
      <span class="flex flex-col items-center gap-0.5 text-primary"><Signpost class="size-4" />Board</span>
      <span class="flex flex-col items-center gap-0.5"><Bookmark class="size-4" />Bookmarks</span>
      <span class="flex flex-col items-center gap-0.5"><Users class="size-4" />People</span>
      <span class="flex flex-col items-center gap-0.5"><Settings class="size-4" />Settings</span>
    </nav>
  </div>
</div>
