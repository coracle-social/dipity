---
import {Bug, Code, LifeBuoy, Mail} from "@lucide/astro"
import Layout from "../layouts/Layout.astro"

const ways = [
  {
    icon: LifeBuoy,
    title: "Help with the app",
    body: "Pairing trouble, a question about a setting, or anything that isn't working the way you expect.",
  },
  {
    icon: Bug,
    title: "Report a problem",
    body: "Tell us what you were doing and what happened. Your phone model and the app version help.",
  },
  {
    icon: Mail,
    title: "Anything else",
    body: "Ideas, press, or a story about how your street uses Dipity. We'd love to hear it.",
  },
]
---

<Layout title="Contact · Dipity" description="Get in touch with the people who make Dipity.">
  <section class="mx-auto max-w-3xl px-5 pt-10 sm:px-8">
    <h1 class="text-4xl font-bold tracking-tight text-balance">Get in touch</h1>
    <p class="mt-4 max-w-xl text-lg text-pretty text-muted-foreground">
      Dipity is made by a small team at Coracle. Email us and a person will write back.
    </p>

    <a
      href="mailto:support@coracle.social"
      class="mt-10 flex items-center gap-4 rounded-2xl bg-card p-6 shadow-md transition hover:shadow-lg">
      <span
        class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-primary text-primary-foreground shadow-control">
        <Mail class="size-5" />
      </span>
      <span>
        <span class="block text-sm text-muted-foreground">Email</span>
        <span class="block text-xl font-semibold">support@coracle.social</span>
      </span>
    </a>

    <div class="mt-6 grid gap-4 sm:grid-cols-3">
      {
        ways.map(way => (
          <div class="rounded-2xl bg-card p-5 shadow-sm">
            <way.icon class="size-5 text-secondary-accent" />
            <h2 class="mt-3 font-semibold">{way.title}</h2>
            <p class="mt-1.5 text-sm leading-relaxed text-pretty text-muted-foreground">{way.body}</p>
          </div>
        ))
      }
    </div>

    <p class="mt-10 flex items-center gap-2 text-sm text-muted-foreground">
      <Code class="size-4" />
      Developers can also find the source and file issues on
      <a
        href="https://gitea.coracle.social/coracle/dipity"
        class="font-medium text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary"
        >Gitea</a
      >.
    </p>
  </section>
</Layout>
