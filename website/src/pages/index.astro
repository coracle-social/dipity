---
import {
  Ban,
  Bluetooth,
  CalendarDays,
  Hand,
  Hourglass,
  Image,
  ListChecks,
  MessageCircle,
  Newspaper,
  ShieldCheck,
  Sprout,
  Users,
} from "@lucide/astro"
import Layout from "../layouts/Layout.astro"
import Phone from "../components/Phone.astro"
import StoreBadges from "../components/StoreBadges.astro"
import Wordmark from "../components/Wordmark.astro"

const steps = [
  {
    icon: Hand,
    title: "Meet in person",
    body: "Hold your phones side by side and give each other a name. There are no profiles, so everyone goes by the names their neighbours give them.",
  },
  {
    icon: MessageCircle,
    title: "Post to the board",
    body: "Publish a note, an event, a poll, a picture or a longer story. Ask a question, lend a ladder, find out who's playing on Friday.",
  },
  {
    icon: Bluetooth,
    title: "Phones pass it on",
    body: "Your phone trades posts with phones in range over Bluetooth, even from your pocket. Walk to the shop, and your post walks with you.",
  },
  {
    icon: Hourglass,
    title: "Let it fade",
    body: "By default, each phone forgets a post 90 days after it arrives, unless you bookmark it.",
  },
]

const kinds = [
  {icon: MessageCircle, label: "Notes"},
  {icon: CalendarDays, label: "Events"},
  {icon: ListChecks, label: "Polls"},
  {icon: Image, label: "Pictures"},
  {icon: Newspaper, label: "Articles"},
]

const values = [
  {
    icon: Sprout,
    title: "No platform in the middle",
    body: "With no intermediary platform, there's no third party that can harvest your data, advertise to community members, or shut down your communications.",
  },
  {
    icon: Users,
    title: "Local stays local",
    body: "Connections are explicitly established with people you meet face-to-face, and none of your content is shared more than two hops away. Local stays local, and you stay in control.",
  },
  {
    icon: Ban,
    title: "No room for trolls",
    body: "With a decentralized, peer-to-peer network, trolls are automatically banned and bad actors are prevented from hijacking your conversations.",
  },
  {
    icon: ShieldCheck,
    title: "Honest about privacy",
    body: "People you meet learn who you are and that you were there; that's how meeting works. Nothing your phone discloses outlasts a single encounter, so following you means following you around.",
  },
]

const questions = [
  {
    q: "Do I need an internet connection?",
    a: "No. Dipity only ever talks to phones within Bluetooth range. There's no account to create and nothing to sign in to.",
  },
  {
    q: "Does it work with the app closed?",
    a: "Yes. Your phone keeps trading posts in the background, so it gathers news while it's in your pocket. On an iPhone, swiping Dipity away stops that until you open it again.",
  },
  {
    q: "Who can see what I post?",
    a: "You choose: only people you've paired with, people you've paired with plus their contacts, or anyone you meet.",
  },
  {
    q: "Is it a social network?",
    a: "Not really. There are no followers, no likes to chase and no algorithm deciding what you see. It's closer to the board by the post office door.",
  },
  {
    q: "What's under the hood?",
    a: "Dipity speaks nostr, an open protocol, so your identity is a key you hold. Back it up, or move it to another phone by holding the two together. It is open source under the MIT license.",
  },
]
---

<Layout>
  <section
    class="mx-auto grid max-w-6xl items-center gap-14 overflow-x-clip px-5 pt-10 pb-20 sm:px-8 lg:grid-cols-[1.1fr_1fr] lg:pt-16">
    <div>
      <h1 class="text-5xl font-bold tracking-tight text-balance sm:text-6xl lg:text-7xl">
        Where your town <span class="text-primary">talks.</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg text-pretty text-muted-foreground sm:text-xl">
        Dipity is a community bulletin board that lives on the phones of the people around you.
        No gatekeepers, no algorithm, just messages passed from phone to phone, pocket to pocket.
      </p>
      <StoreBadges class="mt-9" />
    </div>

    <div class="relative flex justify-center">
      <div class="absolute inset-0 -z-10 flex items-center justify-center" aria-hidden="true">
        <div class="size-[34rem] rounded-full border border-primary/15"></div>
        <div class="absolute size-[26rem] rounded-full border border-primary/20"></div>
        <div class="absolute size-[18rem] rounded-full bg-primary/10 blur-2xl"></div>
      </div>
      <Phone class="animate-drift" />
    </div>
  </section>

  <section class="bg-card py-20 shadow-sm">
    <div class="mx-auto max-w-3xl px-5 text-center sm:px-8">
      <p class="text-sm font-semibold tracking-widest text-primary uppercase">Why Dipity</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-4xl">
        You love your town. Staying in touch is the hard part.
      </h2>
      <p class="mt-4 text-lg text-pretty text-muted-foreground">
        Dipity puts a little friction back into belonging. You hear the news by showing up, so the
        more you're out and about, the closer you are to the pulse of the place you call home.
      </p>
      <ul class="mt-10 flex flex-wrap justify-center gap-3">
        {
          kinds.map(kind => (
            <li class="flex items-center gap-2 rounded-full bg-background px-4 py-2 text-sm font-medium shadow-sm">
              <kind.icon class="size-4 text-primary" />
              {kind.label}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="how-it-works" class="mx-auto max-w-6xl scroll-mt-8 px-5 py-24 sm:px-8">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold tracking-widest text-primary uppercase">How it works</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-4xl">
        A bulletin board that walks around town.
      </h2>
    </div>
    <ol class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((step, index) => (
          <li class="relative rounded-2xl bg-card p-6 shadow-md">
            <span class="absolute top-5 right-6 text-5xl font-bold text-primary/15">{index + 1}</span>
            <span class="flex size-11 items-center justify-center rounded-xl bg-primary/12 text-primary">
              <step.icon class="size-5" />
            </span>
            <h3 class="mt-5 text-lg font-semibold">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-pretty text-muted-foreground">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mx-auto max-w-6xl px-5 sm:px-8">
    <div
      class="grid items-center gap-12 overflow-hidden rounded-3xl bg-foreground px-8 py-14 text-background sm:px-14 lg:grid-cols-2">
      <div>
        <p class="text-sm font-semibold tracking-widest text-primary uppercase">Two hops, then it stops</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-4xl">
          Your words travel from hand to hand.
        </h2>
        <p class="mt-5 text-lg text-pretty opacity-75">
          You hand a post to the people you meet. If you let them, they can pass it to the people
          they've paired with. That's where it ends. Dipity never carries anything further than two
          hops from the person who wrote it.
        </p>
      </div>
      <div class="flex justify-center" aria-hidden="true">
        <svg viewBox="0 0 320 320" class="w-72 max-w-full">
          <circle cx="160" cy="160" r="150" fill="none" stroke="currentColor" stroke-opacity="0.15" stroke-dasharray="4 8"></circle>
          <circle cx="160" cy="160" r="95" fill="none" stroke="currentColor" stroke-opacity="0.25"></circle>
          <g class="text-primary">
            <circle cx="160" cy="160" r="22" fill="currentColor"></circle>
            <circle cx="160" cy="160" r="22" fill="none" stroke="currentColor" stroke-width="3" class="animate-beacon origin-center [transform-box:fill-box]"></circle>
          </g>
          <g fill="currentColor" fill-opacity="0.85">
            <circle cx="160" cy="65" r="12"></circle>
            <circle cx="242" cy="208" r="12"></circle>
            <circle cx="78" cy="208" r="12"></circle>
          </g>
          <g fill="currentColor" fill-opacity="0.45">
            <circle cx="118" cy="22" r="9"></circle>
            <circle cx="205" cy="20" r="9"></circle>
            <circle cx="300" cy="200" r="9"></circle>
            <circle cx="265" cy="280" r="9"></circle>
            <circle cx="20" cy="190" r="9"></circle>
            <circle cx="62" cy="275" r="9"></circle>
          </g>
          <g stroke="currentColor" stroke-opacity="0.35" stroke-width="2">
            <line x1="160" y1="138" x2="160" y2="77"></line>
            <line x1="179" y1="171" x2="231" y2="202"></line>
            <line x1="141" y1="171" x2="89" y2="202"></line>
            <line x1="155" y1="55" x2="124" y2="30"></line>
            <line x1="165" y1="55" x2="200" y2="28"></line>
            <line x1="254" y1="206" x2="291" y2="201"></line>
            <line x1="248" y1="219" x2="260" y2="272"></line>
            <line x1="66" y1="205" x2="29" y2="192"></line>
            <line x1="73" y1="219" x2="65" y2="266"></line>
          </g>
        </svg>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-24 sm:px-8">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold tracking-widest text-primary uppercase">What it stands for</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-4xl">
        Local, and in your hands.
      </h2>
    </div>
    <div class="mt-12 grid gap-5 md:grid-cols-2">
      {
        values.map(value => (
          <div class="flex gap-5 rounded-2xl bg-card p-7 shadow-md">
            <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-secondary-accent/12 text-secondary-accent">
              <value.icon class="size-5" />
            </span>
            <div>
              <h3 class="text-lg font-semibold">{value.title}</h3>
              <p class="mt-2 leading-relaxed text-pretty text-muted-foreground">{value.body}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 sm:px-8">
    <h2 class="text-3xl font-bold tracking-tight">Questions</h2>
    <div class="mt-8 divide-y rounded-2xl bg-card shadow-md">
      {
        questions.map(({q, a}) => (
          <details class="group px-6 py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold">
              {q}
              <span class="text-xl leading-none text-primary transition group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 leading-relaxed text-pretty text-muted-foreground">{a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="mx-auto mt-24 max-w-6xl px-5 text-center sm:px-8">
    <Wordmark pulse class="mx-auto h-24 w-auto sm:h-32" />
    <p class="mx-auto mt-8 max-w-xl text-xl text-pretty text-muted-foreground">
      Put it in your pocket and go for a walk. See who's been talking.
    </p>
    <StoreBadges class="mt-8 justify-center" />
  </section>
</Layout>
